\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Main audit results. Acc/gold/PPL: answer accuracy, gold-letter probability, and perplexity of the scoring suffix for the translated cache (kv-both). PPL entries for translated and identity caches score only the suffix conditioned on the injected cache; the student self-prefill row is the native loss over the full context and suffix in one pass and is not directly comparable (the identity-injection value is the student's suffix PPL). CHG is the gold-probability change over the student's own prefill with 95\% bootstrap CIs. Pairs: Qwen3-4B$\to $1.7B unless noted; rows marked 8B use the Qwen3-8B teacher. $n_{\mathrm  {eval}}$ is the evaluation sample count (tail protocol rows use a fixed evaluation set of 100). All runs use disjoint calibration/evaluation splits and the unified prompt format. ``Gate'' applies the replacement gate of Section~\ref {sec:framework} ($\epsilon {=}0.02$): \emph  {pass} (CI lower bound above $-\epsilon $), \emph  {deg.}\ (CI upper bound below zero, i.e.\ significant degradation), \emph  {n.e.}\ (CI lower bound at or below $-\epsilon $ while the upper bound is at or above zero: neither non-inferiority nor degradation is established). A CI that contains zero therefore does not by itself imply \emph  {n.e.}; for the gradient-trained rows the CHG column is a training range rather than a single interval, with the number of trainings in the row label, and Appendix~\ref {app:repro} lists each range with its worst-case interval bound. Calibration budgets above the pool size ($200$ examples once the fixed evaluation set is held out) saturate and reproduce the full-pool result. $\ddagger $ marks families and axes added while revising and evaluated under the same gates (Section~\ref {sec:tiers}); unmarked translation rows are confirmatory.}}{8}{table.2}\protected@file@percent }
\newlabel{tab:main}{{2}{8}{Main audit results. Acc/gold/PPL: answer accuracy, gold-letter probability, and perplexity of the scoring suffix for the translated cache (kv-both). PPL entries for translated and identity caches score only the suffix conditioned on the injected cache; the student self-prefill row is the native loss over the full context and suffix in one pass and is not directly comparable (the identity-injection value is the student's suffix PPL). CHG is the gold-probability change over the student's own prefill with 95\% bootstrap CIs. Pairs: Qwen3-4B$\to $1.7B unless noted; rows marked 8B use the Qwen3-8B teacher. $n_{\mathrm {eval}}$ is the evaluation sample count (tail protocol rows use a fixed evaluation set of 100). All runs use disjoint calibration/evaluation splits and the unified prompt format. ``Gate'' applies the replacement gate of Section~\ref {sec:framework} ($\epsilon {=}0.02$): \emph {pass} (CI lower bound above $-\epsilon $), \emph {deg.}\ (CI upper bound below zero, i.e.\ significant degradation), \emph {n.e.}\ (CI lower bound at or below $-\epsilon $ while the upper bound is at or above zero: neither non-inferiority nor degradation is established). A CI that contains zero therefore does not by itself imply \emph {n.e.}; for the gradient-trained rows the CHG column is a training range rather than a single interval, with the number of trainings in the row label, and Appendix~\ref {app:repro} lists each range with its worst-case interval bound. Calibration budgets above the pool size ($200$ examples once the fixed evaluation set is held out) saturate and reproduce the full-pool result. $\ddagger $ marks families and axes added while revising and evaluated under the same gates (Section~\ref {sec:tiers}); unmarked translation rows are confirmatory}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Cross-architecture robustness checks. Qwen3-4B teacher to non-Qwen and Qwen2.5 students under the within-family protocol (HellaSwag / ARC, $c{=}30$, $n{=}100$); identity injection passes in every row (self-kv CHG within $\pm 0.001$). ``KV h/d'' gives the student's KV heads and head dimension; the rectangular mapper mean-pools head groups and projects the head dimension. Rows marked ``token-aligned'' align teacher KV to student token positions by character overlap before fitting. No row recovers the teacher's gold probability ($0.691$). ``Gate'' is the replacement gate of Section~\ref {sec:framework} ($\epsilon {=}0.02$, gold CHG); Gemma-2-2B sits at the margin (CI lower bound $-0.020$). Every row in this table is a frozen-gate extension (Section~\ref {sec:tiers}).}}{9}{table.3}\protected@file@percent }
\newlabel{tab:crossarch}{{3}{9}{Cross-architecture robustness checks. Qwen3-4B teacher to non-Qwen and Qwen2.5 students under the within-family protocol (HellaSwag / ARC, $c{=}30$, $n{=}100$); identity injection passes in every row (self-kv CHG within $\pm 0.001$). ``KV h/d'' gives the student's KV heads and head dimension; the rectangular mapper mean-pools head groups and projects the head dimension. Rows marked ``token-aligned'' align teacher KV to student token positions by character overlap before fitting. No row recovers the teacher's gold probability ($0.691$). ``Gate'' is the replacement gate of Section~\ref {sec:framework} ($\epsilon {=}0.02$, gold CHG); Gemma-2-2B sits at the margin (CI lower bound $-0.020$). Every row in this table is a frozen-gate extension (Section~\ref {sec:tiers})}{table.3}{}}
