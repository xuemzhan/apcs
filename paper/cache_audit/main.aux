\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Cross-architecture robustness checks. Qwen3-4B teacher to non-Qwen and Qwen2.5 students under the within-family protocol (HellaSwag / ARC, $c{=}30$, $n{=}100$); identity injection passes in every row (self-kv CHG within $\pm 0.001$). ``KV h/d'' gives the student's KV heads and head dimension; the rectangular mapper mean-pools head groups and projects the head dimension. No row recovers the teacher's gold probability ($0.691$).}}{9}{table.3}\protected@file@percent }
\newlabel{tab:crossarch}{{3}{9}{Cross-architecture robustness checks. Qwen3-4B teacher to non-Qwen and Qwen2.5 students under the within-family protocol (HellaSwag / ARC, $c{=}30$, $n{=}100$); identity injection passes in every row (self-kv CHG within $\pm 0.001$). ``KV h/d'' gives the student's KV heads and head dimension; the rectangular mapper mean-pools head groups and projects the head dimension. No row recovers the teacher's gold probability ($0.691$)}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Oracle probes on Qwen3-4B$\to $1.7B. Left: blending teacher-cache content into the student's own cache (RAT translator) degrades gold probability and accuracy monotonically in the teacher fraction $\alpha $; $\alpha {=}0$ is the student's own cache. Right: per-octant window injection (affine translator; octant $0$ = bottom eighth of student layers); only layers $10$--$13$ (octant $3$) are clearly harmful, while the top three octants are indistinguishable from the student.}}{9}{figure.3}\protected@file@percent }
\newlabel{fig:probes}{{3}{9}{Oracle probes on Qwen3-4B$\to $1.7B. Left: blending teacher-cache content into the student's own cache (RAT translator) degrades gold probability and accuracy monotonically in the teacher fraction $\alpha $; $\alpha {=}0$ is the student's own cache. Right: per-octant window injection (affine translator; octant $0$ = bottom eighth of student layers); only layers $10$--$13$ (octant $3$) are clearly harmful, while the top three octants are indistinguishable from the student}{figure.3}{}}
