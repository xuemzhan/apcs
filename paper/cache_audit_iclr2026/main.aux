\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Main audit results. Acc/gold/PPL: answer accuracy, gold-letter probability, and perplexity of the scoring suffix for the translated cache (kv-both). PPL entries for translated and identity caches score only the suffix conditioned on the injected cache; the student self-prefill row is the native loss over the full context and suffix in one pass and is not directly comparable (the identity-injection value is the student's suffix PPL). CHG is the gold-probability change over the student's own prefill with 95\% bootstrap CIs. Pairs: Qwen3-4B$\to $1.7B unless noted; rows marked 8B use the Qwen3-8B teacher. $n_{\mathrm  {eval}}$ is the evaluation sample count (tail protocol rows use a fixed evaluation set of 100). All runs use disjoint calibration/evaluation splits and the unified prompt format. ``Gate'' applies the replacement gate of Section~\ref {sec:framework} ($\epsilon {=}0.02$): \emph  {pass} (CI lower bound above $-\epsilon $), \emph  {deg.}\ (CI upper bound below zero, i.e.\ significant degradation), \emph  {n.e.}\ (CI lower bound at or below $-\epsilon $ while the upper bound is at or above zero: neither non-inferiority nor degradation is established). A CI that contains zero therefore does not by itself imply \emph  {n.e.}; for the gradient-trained rows the CHG column is a training range rather than a single interval, with the number of trainings in the row label, and Appendix~\ref {app:repro} lists each range with its worst-case interval bound. Calibration budgets above the pool size ($200$ examples once the fixed evaluation set is held out) saturate; auxiliary rows (native content, the 8B pair, per-layer, task-aware, RAT variants, the MLP families and the weak-student RAT row) are in Appendix~\ref {tab:mainaux}. $\ddagger $ marks families and axes added while revising and evaluated under the same gates (Section~\ref {sec:tiers}); unmarked translation rows are confirmatory.}}{6}{table.1}\protected@file@percent }
\newlabel{tab:main}{{1}{6}{Main audit results. Acc/gold/PPL: answer accuracy, gold-letter probability, and perplexity of the scoring suffix for the translated cache (kv-both). PPL entries for translated and identity caches score only the suffix conditioned on the injected cache; the student self-prefill row is the native loss over the full context and suffix in one pass and is not directly comparable (the identity-injection value is the student's suffix PPL). CHG is the gold-probability change over the student's own prefill with 95\% bootstrap CIs. Pairs: Qwen3-4B$\to $1.7B unless noted; rows marked 8B use the Qwen3-8B teacher. $n_{\mathrm {eval}}$ is the evaluation sample count (tail protocol rows use a fixed evaluation set of 100). All runs use disjoint calibration/evaluation splits and the unified prompt format. ``Gate'' applies the replacement gate of Section~\ref {sec:framework} ($\epsilon {=}0.02$): \emph {pass} (CI lower bound above $-\epsilon $), \emph {deg.}\ (CI upper bound below zero, i.e.\ significant degradation), \emph {n.e.}\ (CI lower bound at or below $-\epsilon $ while the upper bound is at or above zero: neither non-inferiority nor degradation is established). A CI that contains zero therefore does not by itself imply \emph {n.e.}; for the gradient-trained rows the CHG column is a training range rather than a single interval, with the number of trainings in the row label, and Appendix~\ref {app:repro} lists each range with its worst-case interval bound. Calibration budgets above the pool size ($200$ examples once the fixed evaluation set is held out) saturate; auxiliary rows (native content, the 8B pair, per-layer, task-aware, RAT variants, the MLP families and the weak-student RAT row) are in Appendix~\ref {tab:mainaux}. $\ddagger $ marks families and axes added while revising and evaluated under the same gates (Section~\ref {sec:tiers}); unmarked translation rows are confirmatory}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Cross-architecture robustness checks. Qwen3-4B teacher to non-Qwen and Qwen2.5 students under the within-family protocol (HellaSwag / ARC, $c{=}30$, $n{=}100$); identity injection passes in every row (self-kv CHG within $\pm 0.001$). ``KV h/d'' gives the student's KV heads and head dimension; the rectangular mapper mean-pools head groups and projects the head dimension. Rows marked ``token-aligned'' align teacher KV to student token positions by character overlap before fitting. No row recovers the teacher's gold probability ($0.691$). ``Gate'' is the replacement gate of Section~\ref {sec:framework} ($\epsilon {=}0.02$, gold CHG); Gemma-2-2B sits at the margin (CI lower bound $-0.020$). Every row in this table is a frozen-gate extension (Section~\ref {sec:tiers}).}}{7}{table.2}\protected@file@percent }
\newlabel{tab:crossarch}{{2}{7}{Cross-architecture robustness checks. Qwen3-4B teacher to non-Qwen and Qwen2.5 students under the within-family protocol (HellaSwag / ARC, $c{=}30$, $n{=}100$); identity injection passes in every row (self-kv CHG within $\pm 0.001$). ``KV h/d'' gives the student's KV heads and head dimension; the rectangular mapper mean-pools head groups and projects the head dimension. Rows marked ``token-aligned'' align teacher KV to student token positions by character overlap before fitting. No row recovers the teacher's gold probability ($0.691$). ``Gate'' is the replacement gate of Section~\ref {sec:framework} ($\epsilon {=}0.02$, gold CHG); Gemma-2-2B sits at the margin (CI lower bound $-0.020$). Every row in this table is a frozen-gate extension (Section~\ref {sec:tiers})}{table.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}H3: No Teacher-Content Probe Improves on the Student}{7}{subsection.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Oracle probes on Qwen3-4B$\to $1.7B ($n{=}30$; the fraction probe is confirmatory, the best-source replication and the octant sweep are frozen-gate extensions, Section~\ref {sec:tiers}). \textbf  {Left}: gold-letter probability as translated teacher content replaces the student's own cache, for two content sources. Filled markers mark mixture fractions whose paired CHG interval excludes zero: the decline separates from the student from $\alpha {=}0.5$ onward for the RAT source and only at $\alpha {=}0.75$ for the affine source, and no mixture at either source yields a gain whose interval excludes zero. \textbf  {Right}: window injection per student-layer octant (affine source), plotted as gold-probability CHG with $95\%$ CIs. Only the octant spanning layers $10$--$13$ excludes zero; two top-layer octants carry small positive point estimates whose intervals span zero.}}{8}{figure.3}\protected@file@percent }
\newlabel{fig:probes}{{3}{8}{Oracle probes on Qwen3-4B$\to $1.7B ($n{=}30$; the fraction probe is confirmatory, the best-source replication and the octant sweep are frozen-gate extensions, Section~\ref {sec:tiers}). \textbf {Left}: gold-letter probability as translated teacher content replaces the student's own cache, for two content sources. Filled markers mark mixture fractions whose paired CHG interval excludes zero: the decline separates from the student from $\alpha {=}0.5$ onward for the RAT source and only at $\alpha {=}0.75$ for the affine source, and no mixture at either source yields a gain whose interval excludes zero. \textbf {Right}: window injection per student-layer octant (affine source), plotted as gold-probability CHG with $95\%$ CIs. Only the octant spanning layers $10$--$13$ excludes zero; two top-layer octants carry small positive point estimates whose intervals span zero}{figure.3}{}}
