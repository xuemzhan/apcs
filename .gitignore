# =========================================================
# APCS 项目 .gitignore
# 对应 design.md §54 KV 存储策略 + §63 run 产物规范
# =========================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 虚拟环境
venv/
env/
ENV/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 测试
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.hypothesis/

# 运行产物（§63 reports/runs/）
# 排除实际跑出来的数据，但保留 .gitkeep 让目录存在
reports/runs/*/t*/cache_bytes.bin
reports/runs/**/__pycache__/
reports/runs/**/*.pyc
# run_id 粘性指针（<base>/<experiment_name>.current）：本机运行状态，不入库。
# 它记录"当前实验用哪个 run_id"，换机器/换 checkout 后应重新生成。
# 注：必须用 ** 才能匹配到 reports/runs/<date>/<name>.current 这类子目录里的指针文件。
reports/runs/**/*.current
# 注意：reports/runs/*/PREREGISTRATION.md 是 §70 必须保留的，不忽略

# 临时文件
*.tmp
*.bak
*.swp
.DS_Store
Thumbs.db

# 日志
*.log
# 例外：Run 内 stdout.log 必须保留（§63 reports/runs/<id>/<task>/stdout.log）
# 此规则放在 *.log 之后才生效（gitignore "最后匹配胜出"）
!reports/runs/*/t*/*.log

# 大文件（KV cache、模型权重）
*.bin
*.safetensors
*.pt
*.pth
*.h5
*.pkl
*.pkl.gz

# 注意：reports/runs/*/PREREGISTRATION.md 是 §70 必须保留的，
# 由 .gitignore 中"未列入排除规则"自动保留。

# 工具运行时状态（.omo/ agent 会话续跑 JSON，不入库）
.omo/

# 工具运行时状态（.opencode/ 技能与 agent 会话续跑状态，不入库）
.opencode/

# Jupyter 检查点（不入库）
.ipynb_checkpoints/
**/.ipynb_checkpoints/
# =========================================================
# v1.2+ 追加：大体量运行数据与临时产物不入库（metrics/summary 等
# 小文件单独选择性提交），保持仓库轻量
# =========================================================
reports/runs/**/*.npz
reports/runs/**/*.bin
reports/runs/**/kv_store/
reports/runs/**/stdout.log
humanizer.tgz
hza.tgz
tmp/
output/pdf/*.aux
output/pdf/*.bbl
output/pdf/*.blg
output/pdf/*.out
archive/
paper/cache_audit/project_context.md

# 论文只有两个在库版本：paper/arxiv（arXiv 完整稿）与 paper/iclr2026（ICLR 2026 投稿稿）。
# 两处都只保留源文件 / main.bbl / 成品 PDF：编译中间产物不入库。
paper/arxiv/*.aux
paper/arxiv/*.blg
paper/arxiv/*.log
paper/arxiv/*.out
paper/iclr2026/*.aux
paper/iclr2026/*.blg
paper/iclr2026/*.log
paper/iclr2026/*.out
# 去 AI 味改写副本（paper/humanized）：同样只留源文件 / main.bbl / 成品 PDF
paper/humanized/*/*.aux
paper/humanized/*/*.blg
paper/humanized/*/*.log
paper/humanized/*/*.out
# 其余历史版本与预览（含 paper/archive/）不入库
paper/legacy_*/*.aux

# KV cache / mapper params（可复现生成的二进制，非跨机资产）
*.npz
reports/runs/**/kv_store/
reports/runs/**/*.current
